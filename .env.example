# Campus Care Environment Configuration

# Session authentication secret (replace with a 32+ character random string in production)
SESSION_SECRET=your-random-32-char-session-secret-here

# Optional: Cookie secure flag override for local http testing (defaults to true in production)
COOKIE_SECURE=true

# Optional: Custom database file path (defaults to .data/db.json locally, /tmp on serverless)
DB_PATH=./.data/db.json

# Optional: Public application URL
NEXT_PUBLIC_APP_URL=https://your-domain.vercel.app

# Port for local production test server
PORT=3000
